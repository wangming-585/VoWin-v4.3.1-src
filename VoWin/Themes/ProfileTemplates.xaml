<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:VoWin.Helpers">
    <converters:MaskedIdentifierConverter x:Key="MaskId" />

    <!-- Shared eSIM Profile card. The device-management page and the SMS page
         render the same profile the same way, so the template lives here
         instead of being duplicated per page.

         The template binds to the Profile model (ProfileName / State /
         ProviderName / ICCID). The enable button resolves its command
         against the page-level DataContext, so both pages only have to
         expose a SwitchEuiccProfileCommand / SwitchProfileCommand. -->

    <converters:ProfileStateToColorConverter x:Key="ProfileStateColor" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVis" />

    <!-- Compact card used in narrow panes (SMS page). Shows name, state and
         ICCID with a single "enable" action. -->
    <DataTemplate x:Key="EuiccProfileCompactTemplate">
        <Border
            Margin="0,2"
            Padding="8,6"
            CornerRadius="6"
            Background="{DynamicResource AppInputBrush}"
            BorderBrush="{DynamicResource AppCardBorderBrush}"
            BorderThickness="1"
        >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- State color indicator -->
                <Border
                    Grid.Column="0"
                    CornerRadius="6,0,0,6"
                    Background="{Binding State, Converter={StaticResource ProfileStateColor}}"
                />

                <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                    <!-- Row 1: name + state + provider -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            Text="{Binding ProfileName, Mode=OneWay, FallbackValue=未命名}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"
                        />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding State, Mode=OneWay}" FontSize="10" FontWeight="Medium" Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Enabled">
                                                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock
                                Text="{Binding ProviderName, Mode=OneWay}"
                                FontSize="10"
                                Foreground="{DynamicResource AppTextTertiaryBrush}"
                            />
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: ICCID -->
                    <TextBlock
                        Text="{Binding ICCID, Mode=OneWay, Converter={StaticResource MaskId}}"
                        ToolTip="{Binding ICCID, Mode=OneWay}"
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="{DynamicResource AppTextSecondaryBrush}"
                        Margin="0,3,0,0"
                        TextTrimming="CharacterEllipsis"
                    />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button
                        Padding="10,4"
                        FontSize="11"
                        Margin="0,0,6,0"
                        Appearance="Primary"
                        Content="启用"
                        IsEnabled="{Binding IsCurrentlyAddressable}"
                        Command="{Binding DataContext.SwitchProfileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                    />
                    <ui:Button
                        Padding="10,4"
                        FontSize="11"
                        Appearance="Secondary"
                        Content="禁用"
                        Visibility="{Binding IsEnabledState, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.DisableProfileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                    />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
