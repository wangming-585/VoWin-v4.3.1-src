<Application
    x:Class="VoWin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    DispatcherUnhandledException="OnDispatcherUnhandledException"
    Exit="OnExit"
    ShutdownMode="OnMainWindowClose"
    Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/DesignSystem.xaml" />
                <ResourceDictionary Source="Themes/ProfileTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand-blue interaction defaults; App.ApplyBrandTheme refreshes
                 these values for light and dark themes at runtime. -->
            <!-- Embedded CJK font (Microsoft YaHei regular + bold) so text renders
                 identically on machines without the font installed. Consolas first for
                 monospaced Latin/digits, YaHei for CJK. -->
            <FontFamily x:Key="GlobalAppFontFamily">Consolas, ./Fonts/msyh.ttc#Microsoft YaHei, Microsoft YaHei, Segoe UI</FontFamily>
            <FontFamily x:Key="GlobalAppFontFamilyBold">Consolas, ./Fonts/msyhbd.ttc#Microsoft YaHei, Microsoft YaHei UI, Segoe UI</FontFamily>

            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#007AFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#0071E3" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#0064D2" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#007AFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#0071E3" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#0064D2" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#4D007AFF" />

            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#007AFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#0071E3" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#0064D2" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#007AFF" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#0064D2" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
