<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- VoWin visual language: Apple/macOS-inspired design. Neutral gray
         surfaces, hairline separators, white cards and a single system-blue
         accent. Values are refreshed by App.ApplyBrandTheme whenever the
         theme changes. -->
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="AppNavigationBrush" Color="#ECECEE" />
    <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppCardElevatedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#E3E3E6" />
    <SolidColorBrush x:Key="AppDividerBrush" Color="#E5E5EA" />
    <SolidColorBrush x:Key="AppInputBrush" Color="#F2F2F4" />
    <SolidColorBrush x:Key="AppHoverBrush" Color="#E8E8EC" />
    <SolidColorBrush x:Key="AppSelectedBrush" Color="#DCE7FA" />
    <SolidColorBrush x:Key="AppOverlayBrush" Color="#59000000" />

    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#8E8E93" />
    <SolidColorBrush x:Key="AppTextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppTextOnAccentSecondaryBrush" Color="#DCE8FF" />

    <SolidColorBrush x:Key="AppAccentBrush" Color="#007AFF" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#0071E3" />
    <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#0064D2" />
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#E5F0FF" />
    <SolidColorBrush x:Key="AppAccentSoftBorderBrush" Color="#B3D4FC" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#248A3D" />
    <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="#E8F8EC" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="#C93400" />
    <SolidColorBrush x:Key="AppWarningSoftBrush" Color="#FFF3E5" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="#D70015" />
    <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#FFEBEE" />
    <SolidColorBrush x:Key="AppInfoBrush" Color="#007AFF" />
    <SolidColorBrush x:Key="AppInfoSoftBrush" Color="#E5F0FF" />

    <!-- Non-text visual tokens used by page-level effects and QR previews. -->
    <SolidColorBrush x:Key="AppQrSurfaceBrush" Color="#FFFFFF" />
    <Color x:Key="AppShadowColor">#000000</Color>
    <Color x:Key="AppSuccessShadowColor">#16A34A</Color>
    <Color x:Key="AppDangerShadowColor">#DC2626</Color>

    <!-- Floating call/SMS alerts intentionally remain dark in both themes so
         they are immediately recognizable above arbitrary desktop content. -->
    <SolidColorBrush x:Key="AppFloatingSurfaceBrush" Color="#F2141D2C" />
    <SolidColorBrush x:Key="AppFloatingBorderBrush" Color="#52FFFFFF" />
    <SolidColorBrush x:Key="AppFloatingTextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppFloatingTextSecondaryBrush" Color="#CAD5E3" />
    <SolidColorBrush x:Key="AppFloatingTextTertiaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="AppFloatingTrackBrush" Color="#334155" />
    <SolidColorBrush x:Key="AppFloatingSuccessSoftBrush" Color="#2634D399" />
    <SolidColorBrush x:Key="AppFloatingAccentSoftBrush" Color="#2660A5FA" />

    <!-- Adapt the WPF-UI primitives so third-party controls and native VoWin
         cards participate in the same surface hierarchy. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E3E3E6" />

    <Style TargetType="{x:Type Page}">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="AppPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="AppPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>

    <Style x:Key="AppCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppInputLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>

    <Style x:Key="AppCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="AppCompactCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="AppSoftPanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="AppAccentPanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentSoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="AppStatusPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    </Style>

    <Style x:Key="AppDividerStyle" TargetType="Separator">
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="Background" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="Height" Value="1" />
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Background" Value="{DynamicResource AppCardElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>
