<ui:FluentWindow
  x:Class="VoWin.Views.Windows.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:VoWin.Helpers"
  xmlns:local="clr-namespace:VoWin.Views.Windows"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
  Icon="pack://application:,,,/Assets/vowin.png"
  Width="1280"
  Height="820"
  MinWidth="1024"
  MinHeight="680"
  d:DataContext="{d:DesignInstance local:MainWindow,
                                     IsDesignTimeCreatable=True}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource AppTextPrimaryBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource AppTextPrimaryBrush}"
  FontFamily="{StaticResource GlobalAppFontFamily}"
  FontSize="13"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  UseLayoutRounding="True"
  SnapsToDevicePixels="True"
  TextOptions.TextFormattingMode="Display"
  TextOptions.TextRenderingMode="Grayscale"
  RenderOptions.BitmapScalingMode="HighQuality"
  mc:Ignorable="d"
>
  <ui:FluentWindow.Resources>
    <helpers:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
    <helpers:NullToVisibilityConverter x:Key="NullToVis" />
    <!-- 自定义 TitleBar 样式：移除 PART_Icon 的写死 Height="16"，让 1:1 正方形图标能够按原始比例完整展示，不被上下裁切遮挡 -->
    <Style TargetType="{x:Type ui:TitleBar}" BasedOn="{StaticResource {x:Type ui:TitleBar}}">
      <Setter Property="Padding" Value="12,0,8,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ui:TitleBar}">
            <Grid
              x:Name="PART_MainGrid"
              HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
              Background="{TemplateBinding Background}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Grid
                x:Name="TitleGrid"
                Grid.Column="0"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 应用图标：自适应高度与宽度，支持 1:1 完整显示不遮挡 -->
                <ContentPresenter
                  x:Name="PART_Icon"
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  AutomationProperties.AutomationId="TitleBarIcon"
                  Content="{TemplateBinding Icon}"
                  Focusable="False"
                  RenderOptions.BitmapScalingMode="HighQuality" />
              </Grid>

              <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 标题文本 -->
                <ContentPresenter
                  Grid.Column="0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Content="{TemplateBinding Header}" />

                <!-- 居中内容 -->
                <ContentPresenter
                  Grid.Column="1"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  Content="{TemplateBinding CenterContent}" />

                <!-- 尾部附加内容 -->
                <ContentPresenter
                  Grid.Column="2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Content="{TemplateBinding TrailingContent}" />

                <!-- 窗口控制按钮：帮助、最小化、最大化/还原、关闭 -->
                <Grid
                  Grid.Column="3"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <ui:TitleBarButton
                    x:Name="PART_HelpButton"
                    Grid.Column="0"
                    AutomationProperties.AutomationId="TitleBarHelpButton"
                    ButtonType="Help" />

                  <ui:TitleBarButton
                    x:Name="PART_MinimizeButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="TitleBarMinimizeButton"
                    ButtonType="Minimize" />

                  <ui:TitleBarButton
                    x:Name="PART_MaximizeButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="TitleBarMaximizeButton"
                    ButtonType="Maximize"
                    IsHitTestVisible="True" />

                  <ui:TitleBarButton
                    x:Name="PART_CloseButton"
                    Grid.Column="4"
                    AutomationProperties.AutomationId="TitleBarCloseButton"
                    ButtonType="Close"
                    MouseOverBackground="{DynamicResource PaletteRedBrush}"
                    MouseOverButtonsForeground="White" />
                </Grid>
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Icon" Value="{x:Null}" />
                  <Condition Property="Title" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="TitleGrid" Property="Visibility" Value="Collapsed" />
              </MultiTrigger>
              <Trigger Property="ApplicationTheme" Value="Dark">
                <Setter Property="ButtonsBackground">
                  <Setter.Value>
                    <SolidColorBrush Color="#17FFFFFF" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_Icon" Property="Margin" Value="0" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="ShowMaximize" Value="True" />
                  <Condition Property="IsMaximized" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_MaximizeButton" Property="ButtonType" Value="Restore" />
              </MultiTrigger>
              <Trigger Property="ShowHelp" Value="False">
                <Setter TargetName="PART_HelpButton" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="ShowMinimize" Value="False">
                <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="ShowMaximize" Value="False">
                <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="ShowClose" Value="False">
                <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavItemButtonStyle" TargetType="Button">
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="7"
                    Background="{TemplateBinding Background}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- 图标（Content 里的 SymbolIcon） -->
                <Border x:Name="iconHost" Grid.Column="0" Margin="8,0,10,0"
                        Width="24" Height="24" CornerRadius="6"
                        Background="{DynamicResource AppInputBrush}"
                        BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                  <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <!-- 文字 -->
                <TextBlock x:Name="label" Grid.Column="1" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:NavProperties.Label)}"
                           VerticalAlignment="Center" FontWeight="Medium" UseLayoutRounding="True"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="Grayscale"
                           Foreground="{TemplateBinding Foreground}"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppSelectedBrush}" />
              </Trigger>
              <Trigger Property="local:NavProperties.IsActive" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                <Setter TargetName="label" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="iconHost" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                <Setter TargetName="iconHost" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                <Setter TargetName="iconHost" Property="Width" Value="26" />
                <Setter TargetName="iconHost" Property="Height" Value="26" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </ui:FluentWindow.Resources>

  <Grid Background="{DynamicResource AppSurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210" />
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左侧导航（菜单选择宿主，页面渲染统由 MainFrame 承载） -->
      <Border
        Grid.Column="0"
        Background="{DynamicResource AppNavigationBrush}"
        BorderBrush="{DynamicResource AppCardBorderBrush}"
        BorderThickness="0,0,1,0"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="8,10,8,8">
            <Button Style="{StaticResource NavItemButtonStyle}"
                    local:NavProperties.Label="首页"
                    Tag="Dashboard" Click="OnNavClick" local:NavProperties.IsActive="False">
              <ui:SymbolIcon Symbol="Home16" FontSize="13"
                             Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}" />
            </Button>
            <Button Style="{StaticResource NavItemButtonStyle}"
                    local:NavProperties.Label="短信"
                    Tag="Messages" Click="OnNavClick" local:NavProperties.IsActive="False">
              <ui:SymbolIcon Symbol="Chat16" FontSize="13"
                             Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}" />
            </Button>
            <Button Style="{StaticResource NavItemButtonStyle}"
                    local:NavProperties.Label="电话"
                    Tag="Phone" Click="OnNavClick" local:NavProperties.IsActive="False">
              <ui:SymbolIcon Symbol="Call24" FontSize="13"
                             Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}" />
            </Button>
            <Button Style="{StaticResource NavItemButtonStyle}"
                    local:NavProperties.Label="eSIM 管理"
                    Tag="ModemManager" Click="OnNavClick" local:NavProperties.IsActive="False">
              <ui:SymbolIcon Symbol="Sim24" FontSize="13"
                             Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}" />
            </Button>
            <Button Style="{StaticResource NavItemButtonStyle}"
                    local:NavProperties.Label="系统诊断"
                    Tag="SystemStatus" Click="OnNavClick" local:NavProperties.IsActive="False">
              <ui:SymbolIcon Symbol="Pulse24" FontSize="13"
                             Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}" />
            </Button>
            <Button Style="{StaticResource NavItemButtonStyle}"
                    local:NavProperties.Label="代理分流"
                    Tag="Proxy" Click="OnNavClick" local:NavProperties.IsActive="False">
              <ui:SymbolIcon Symbol="ArrowSplit20" FontSize="13"
                             Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}" />
            </Button>
            <Button Style="{StaticResource NavItemButtonStyle}"
                    local:NavProperties.Label="远程控制"
                    Tag="RemoteControl" Click="OnNavClick" local:NavProperties.IsActive="False">
              <ui:SymbolIcon Symbol="DesktopArrowRight20" FontSize="13"
                             Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}" />
            </Button>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="8,0,8,12">
            <Border Height="1" Margin="0,0,0,8" Background="{DynamicResource AppCardBorderBrush}" />
            <Button Style="{StaticResource NavItemButtonStyle}"
                    local:NavProperties.Label="设置"
                    Tag="Settings" Click="OnNavClick" local:NavProperties.IsActive="False">
              <ui:SymbolIcon Symbol="Settings16" FontSize="13"
                             Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>


      <!-- 左侧第二栏：全局 eSIM 面板（位于导航与主内容之间） -->
      <Border
        Grid.Column="1"
        Width="300"
        Margin="0,0,0,0"
        Background="{DynamicResource AppNavigationBrush}"
        BorderBrush="{DynamicResource AppCardBorderBrush}"
        BorderThickness="1,0,0,0">
        <Grid Margin="12,10,12,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- 侧栏标题：eSIM -->
          <Grid Grid.Row="0" Margin="0,6,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Sim24" FontSize="14" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" />
              <TextBlock Text="eSIM" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding ViewModel.EuiccSummary, Mode=OneWay}"
                       FontSize="10" Foreground="{DynamicResource AppTextTertiaryBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>

          <!-- eSIM Profile 列表 -->
          <ListView Grid.Row="1" Margin="0,0,0,8"
                    ItemsSource="{Binding ViewModel.EuiccProfiles}"
                    Background="Transparent" BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding ViewModel.HasEuiccProfiles, Converter={StaticResource BoolToVis}}">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,1" Padding="6,2" CornerRadius="6"
                        Background="{DynamicResource AppInputBrush}"
                        BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="3" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="6,0,0,6"
                            Background="{Binding State, Converter={StaticResource ProfileStateColor}}" />
                    <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="{Binding DisplayName, Mode=OneWay, FallbackValue=未命名}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding State, Mode=OneWay}"
                                   FontSize="10" Foreground="{DynamicResource AppTextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Text="{Binding PhoneToCopy, Mode=OneWay}"
                                 Visibility="{Binding PhoneToCopy, Mode=OneWay, Converter={StaticResource NullToVis}}"
                                 FontSize="15" FontWeight="Bold" Margin="0,1,0,0"
                                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <TextBlock Text="{Binding AnnotationText, Mode=OneWay}"
                                   Visibility="{Binding AnnotationText, Mode=OneWay, Converter={StaticResource NullToVis}}"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <ui:Button Content="复制" Appearance="Secondary" FontSize="9" Padding="5,1"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasPhone, Converter={StaticResource BoolToVis}}"
                                   Command="{Binding ViewModel.CopyPhoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding PhoneToCopy}" />
                        <ui:Button Content="改号" Appearance="Secondary" FontSize="9" Padding="5,1"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   ToolTip="手动编辑这张卡的手机号（运营商不下发号码或物联网卡时使用）"
                                   Command="{Binding ViewModel.EditPhoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding Inner}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <ui:ProgressRing Width="12" Height="12" IsIndeterminate="True"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                         VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                   Visibility="{Binding StatusText, Mode=OneWay, Converter={StaticResource NullToVis}}"
                                   FontSize="9" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding RetryText, Mode=OneWay}"
                                   Visibility="{Binding RetryText, Mode=OneWay, Converter={StaticResource NullToVis}}"
                                   FontSize="9" Foreground="{DynamicResource AppAccentBrush}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                        <ui:Button Content="重试" Appearance="Secondary" FontSize="9" Padding="5,1"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   ToolTip="立即重新发起 VoWiFi 连接"
                                   Visibility="{Binding RetryText, Mode=OneWay, Converter={StaticResource NullToVis}}"
                                   Command="{Binding ViewModel.RetryVoWifiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding Inner}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <ui:Button Content="启用" Appearance="Primary" FontSize="10" Padding="8,3"
                                 IsEnabled="{Binding IsCurrentlyAddressable}"
                                 Command="{Binding ViewModel.SwitchProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="{Binding Inner}" />
                      <ui:Button Content="禁用" Appearance="Secondary" FontSize="10" Padding="8,3"
                                 Margin="4,0,0,0"
                                 Visibility="{Binding IsEnabledState, Converter={StaticResource BoolToVis}}"
                                 Command="{Binding ViewModel.DisableProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="{Binding Inner}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <!-- 无 eSIM 空态 -->
          <TextBlock Grid.Row="2" Text="无 eSIM 卡片" FontSize="11"
                     Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,4,0,0"
                     Visibility="{Binding ViewModel.HasEuiccProfiles, Converter={StaticResource InvertBoolToVis}}" />
        </Grid>
      </Border>
      <!-- 第3列：主内容宿主（页面渲染由 MainFrame 承载，导航仅提供菜单） -->
      <Frame
        x:Name="MainFrame"
        Grid.Column="2"
        Grid.Row="0"
        Grid.RowSpan="2"
        NavigationUIVisibility="Hidden"
        Background="Transparent"
      />
      <ContentPresenter x:Name="RootContentDialog" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="90" />

      <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="95" IsHitTestVisible="False">
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
      </Grid>
    </Grid>
    <ui:TitleBar
      x:Name="TitleBar"
      Title="{Binding ViewModel.ApplicationTitle}"
      Grid.Row="0"
      Height="38"
      Background="{DynamicResource AppNavigationBrush}"
      CloseWindowByDoubleClickOnIcon="True"
    >
      <ui:TitleBar.Icon>
        <ui:ImageIcon
          Source="pack://application:,,,/Assets/vowin.png"
          Width="24"
          Height="24"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          RenderOptions.BitmapScalingMode="HighQuality"
        />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
    <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100"
            Background="{DynamicResource AppOverlayBrush}" IsHitTestVisible="True">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding KernelService.IsInitialScanRunning}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border Width="380" Padding="34" CornerRadius="18"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource AppCardElevatedBrush}"
              BorderBrush="{DynamicResource AppCardBorderBrush}"
              BorderThickness="1">
        <StackPanel HorizontalAlignment="Center">
          <ui:ProgressRing Width="52" Height="52" IsIndeterminate="True" Margin="0,0,0,20" />
          <TextBlock Text="正在准备蜂窝设备" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding KernelService.InitialScanStatus}" HorizontalAlignment="Center" Margin="0,10,0,0"
                     Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock Text="正在依次检查串口、SIM 卡和 USIM 应用；首次启动通常需要几秒钟。"
                     HorizontalAlignment="Center" Margin="0,12,0,0" MaxWidth="290"
                     Foreground="{DynamicResource AppTextTertiaryBrush}" FontSize="12"
                     TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</ui:FluentWindow>
